# Executable should be a full path
executable=/path/to/condor_Xgpu.sh

# Hyperparameters are specified in a YAML configuration file
config=/path/to/.yaml

# Queue as many jobs as points in the hyperparameter grid
n_jobs=

# Pass arguments to the executable
arguments = $(config) $(Process)

# Logs
LOGS_DIR=/path/to/logs
error = $(LOGS_DIR)/err/job.$(Cluster).$(Process).err
output = $(LOGS_DIR)/out/job.$(Cluster).$(Process).out
log = $(LOGS_DIR)/log/job.$(Cluster).$(Process).log

# Job requirements
request_memory = 250000
request_cpus = 20
request_gpus = X
requirements = (TARGET.CUDADeviceName == "NVIDIA B200") && (TARGET.Machine != "g147.internal.cluster.is.localnet") && (TARGET.Machine != "g132.internal.cluster.is.localnet") && (TARGET.Machine != "g174.internal.cluster.is.localnet")
# TARGET.CUDADeviceName == "NVIDIA B200"
# TARGET.CUDADeviceName == "NVIDIA A100-SXM4-80GB"

queue $(n_jobs)
