# Executable should be a full path
executable=/path/to/downstream_eval.sh

# Path to .pth checkpoint
ckpt=/path/to/.pth

# Optional lm-eval controls
# Use "none" for a full evaluation, an integer for N examples per task, or a
# float in (0, 1] for a fraction of each task.
limit=none
tasks=piqa,arc_easy
batch_size=64
device=auto
hf_cache_dir=/path/to/lm-eval-cache

# Pass arguments to the executable
arguments = $(ckpt) $(limit) $(tasks) $(batch_size) $(device) $(hf_cache_dir)

# Logs
LOGS_DIR=/path/to/logs
error = $(LOGS_DIR)/err/job.$(Cluster).$(Process).err
output = $(LOGS_DIR)/out/job.$(Cluster).$(Process).out
log = $(LOGS_DIR)/log/job.$(Cluster).$(Process).log

# Job requirements
request_memory = 25000
request_cpus = 8
request_gpus = 1
requirements = (TARGET.CUDADeviceName == "NVIDIA A100-SXM4-80GB") && (TARGET.Machine != "g147.internal.cluster.is.localnet") && (TARGET.Machine != "g132.internal.cluster.is.localnet") && (TARGET.Machine != "g174.internal.cluster.is.localnet")

queue 1