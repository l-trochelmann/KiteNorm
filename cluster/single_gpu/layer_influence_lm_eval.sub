# Executable should be a full path
executable=/lustre/home/ltrochelmann/LN-variants/cluster/single_gpu/layer_influence_lm_eval.sh

# Path to .pth checkpoint
ckpt=/fast/ltrochelmann/exp/main/TR_ours_48L_scalarLN_var-mean-std/job_idx_0/ckpt_micro_step_24415.pth

# Optional lm-eval controls
# Use "none" for a full evaluation, an integer for N examples per task, or a
# float in (0, 1] for a fraction of each task.
limit=none
tasks=piqa
batch_size=32
device=auto
hf_cache_dir=/fast/ltrochelmann/data/lm/lm-eval

# Pass arguments to the executable
arguments = $(ckpt) $(limit) $(tasks) $(batch_size) $(device) $(hf_cache_dir)

